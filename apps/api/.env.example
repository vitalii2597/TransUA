DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transua"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Email (password reset). Without SENDGRID_API_KEY nothing is sent; set
# MAIL_LOG_TO_CONSOLE="true" locally to print emails (incl. reset links) to the
# API console instead. Never enable it on a deployed server.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@transua.no"
SENDGRID_FROM_NAME="TransUA"
MAIL_LOG_TO_CONSOLE="false"
